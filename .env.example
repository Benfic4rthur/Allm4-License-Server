NODE_ENV=development
PORT=3000

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Banco de dados
DATABASE_URL=

# Protecao administrativa e hashes de licenca/dispositivo
ADMIN_SECRET=
LICENSE_HASH_SECRET=

# Assinatura Ed25519 para licencas offline
# Aceita PEM com quebras de linha ou o PEM completo codificado em Base64.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=


# Relatorios de bugs
# Use segredos aleatorios diferentes dos demais.
# O servidor usa LICENSE_HASH_SECRET e ADMIN_SECRET como fallback,
# então estas duas variáveis são opcionais no primeiro teste.
BUG_REPORT_SECRET=
BUG_MAINTAINER_SECRET=
